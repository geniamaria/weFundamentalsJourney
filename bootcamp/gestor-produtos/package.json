{
  "name": "gestor-produtos",
  "version": "1.0.0",
  "description": "Gestor de Produtos — projecto educativo de TypeScript avançado (tipos, POO, Zod e API externa).",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
